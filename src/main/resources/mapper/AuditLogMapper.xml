<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiapp.mapper.AuditLogMapper">

    <resultMap id="BaseResultMap" type="com.example.aiapp.domain.entity.AuditLogEntity">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="action" property="action"/>
        <result column="target" property="target"/>
        <result column="target_id" property="targetId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, action, target, target_id, created_at
    </sql>

    <select id="selectPageOrderByCreatedAtDesc" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM audit_log
        ORDER BY created_at DESC, id DESC
    </select>

</mapper>
