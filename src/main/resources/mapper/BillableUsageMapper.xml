<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiapp.mapper.BillableUsageMapper">

    <resultMap id="BaseResultMap" type="com.example.aiapp.domain.entity.BillableUsageEntity">
        <id column="id" property="id"/>
        <result column="usage_event_id" property="usageEventId"/>
        <result column="user_id" property="userId"/>
        <result column="account_id" property="accountId"/>
        <result column="pricing_version_code" property="pricingVersionCode"/>
        <result column="charge_credit_micros" property="chargeCreditMicros"/>
        <result column="usage_source" property="usageSource"/>
        <result column="status" property="status"/>
        <result column="reservation_id" property="reservationId"/>
        <result column="ledger_entry_id" property="ledgerEntryId"/>
        <result column="metadata_json" property="metadataJson"/>
        <result column="created_at" property="createdAt"/>
        <result column="settled_at" property="settledAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, usage_event_id, user_id, account_id, pricing_version_code, charge_credit_micros, usage_source, status, reservation_id, ledger_entry_id, metadata_json, created_at, settled_at
    </sql>

    <!-- MyBatis-Plus 通用 CRUD 由 BaseMapper 提供；自定义 SQL 在此文件扩展。 -->

</mapper>
