<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiapp.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.example.aiapp.domain.entity.ChatMessageEntity">
        <id column="id" property="id"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="turn_id" property="turnId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="metadata_json" property="metadataJson"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, conversation_id, turn_id, role, content, metadata_json, created_at
    </sql>

    <select id="selectByConversationId" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM chat_message
        WHERE conversation_id = #{conversationId}
        ORDER BY created_at ASC
    </select>

    <select id="selectByConversationIdAndTurnId" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM chat_message
        WHERE conversation_id = #{conversationId}
          AND turn_id = #{turnId}
          AND role = 'assistant'
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <select id="selectUserByConversationIdAndTurnId" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM chat_message
        WHERE conversation_id = #{conversationId}
          AND turn_id = #{turnId}
          AND role = 'user'
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <delete id="deleteByConversationId">
        DELETE FROM chat_message
        WHERE conversation_id = #{conversationId}
    </delete>

</mapper>
