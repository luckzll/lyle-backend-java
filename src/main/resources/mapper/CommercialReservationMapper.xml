<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiapp.mapper.CommercialReservationMapper">

    <resultMap id="BaseResultMap" type="com.example.aiapp.domain.entity.CommercialReservationEntity">
        <id column="id" property="id"/>
        <result column="account_id" property="accountId"/>
        <result column="user_id" property="userId"/>
        <result column="turn_id" property="turnId"/>
        <result column="reserved_credit_micros" property="reservedCreditMicros"/>
        <result column="consumed_credit_micros" property="consumedCreditMicros"/>
        <result column="status" property="status"/>
        <result column="expires_at" property="expiresAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, account_id, user_id, turn_id, reserved_credit_micros, consumed_credit_micros, status, expires_at, created_at, updated_at
    </sql>

    <!-- MyBatis-Plus 通用 CRUD 由 BaseMapper 提供；自定义 SQL 在此文件扩展。 -->

</mapper>
