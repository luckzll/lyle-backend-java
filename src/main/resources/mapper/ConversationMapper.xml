<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiapp.mapper.ConversationMapper">

    <select id="selectByUserId" resultType="com.example.aiapp.domain.entity.ConversationEntity">
        SELECT
            id,
            user_id,
            title,
            created_at,
            updated_at
        FROM conversation
        WHERE user_id = #{userId}
        ORDER BY updated_at DESC
    </select>

    <select id="selectByIdAndUserId" resultType="com.example.aiapp.domain.entity.ConversationEntity">
        SELECT
            id,
            user_id,
            title,
            created_at,
            updated_at
        FROM conversation
        WHERE id = #{id}
          AND user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
