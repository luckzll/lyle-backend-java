<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiapp.mapper.ConversationMapper">

    <resultMap id="BaseResultMap" type="com.example.aiapp.domain.entity.ConversationEntity">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, title, created_at, updated_at
    </sql>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM conversation
        WHERE user_id = #{userId}
        ORDER BY updated_at DESC
    </select>

    <select id="selectByIdAndUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM conversation
        WHERE id = #{id}
          AND user_id = #{userId}
        LIMIT 1
    </select>

    <select id="selectPageByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM conversation
        WHERE user_id = #{userId}
        ORDER BY updated_at DESC, id DESC
    </select>

</mapper>
