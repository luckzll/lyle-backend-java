<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiapp.mapper.KnowledgeBaseMapper">

    <select id="selectByUserId" resultType="com.example.aiapp.domain.entity.KnowledgeBaseEntity">
        SELECT
            id,
            user_id,
            name,
            created_at
        FROM knowledge_base
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <select id="selectByIdAndUserId" resultType="com.example.aiapp.domain.entity.KnowledgeBaseEntity">
        SELECT
            id,
            user_id,
            name,
            created_at
        FROM knowledge_base
        WHERE id = #{id}
          AND user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
